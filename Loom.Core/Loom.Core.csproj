<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Loom.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.editorconfig">
            <Link>.editorconfig</Link>
        </Content>
        <Content Include="..\.gitignore">
            <Link>.gitignore</Link>
        </Content>
        <Content Include="..\CLAUDE.md">
            <Link>CLAUDE.md</Link>
        </Content>
        <Content Include="..\AGENTS.md">
            <Link>AGENTS.md</Link>
        </Content>
        <Content Include="..\CODEOWNERS">
            <Link>CODEOWNERS</Link>
        </Content>
        <Content Include="..\CONTRIBUTING.md">
            <Link>CONTRIBUTING.md</Link>
        </Content>
        <Content Include="..\qodana.yaml">
            <Link>qodana.yaml</Link>
        </Content>
        <Content Include="..\README.md">
            <Link>README.md</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Loom.Config\Loom.Config.csproj"/>
        <ProjectReference Include="..\Loom.Luau\Loom.Luau.csproj"/>
    </ItemGroup>

    <!--
        Intrinsic .loom sources are embedded rather than read off disk at runtime: Intrinsics.cs
        used to resolve a path relative to AppContext.BaseDirectory and scan it with
        Directory.GetFiles, which silently returns nothing in sandboxed hosts with no real
        filesystem (e.g. the Blazor WebAssembly playground), leaving every intrinsic unavailable.
        LogicalNames are listed explicitly (not globbed with %(RecursiveDir)) so the resource name
        always uses '/' regardless of the OS running the build - %(RecursiveDir) emits '\' on
        Windows, which Intrinsics.cs' Path.GetFileName lookup would then fail to split on under
        WASM's Unix-style path semantics.
    -->
    <ItemGroup>
        <EmbeddedResource Include="TypeChecking\Intrinsic\loom.loom">
            <LogicalName>Intrinsic/loom.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\math.loom">
            <LogicalName>Intrinsic/math.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\buffer.loom">
            <LogicalName>Intrinsic/buffer.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\runtime.loom">
            <LogicalName>Intrinsic/runtime.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\generated\None.loom">
            <LogicalName>Intrinsic/generated/None.loom</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="TypeChecking\Intrinsic\generated\PluginSecurity.loom">
            <LogicalName>Intrinsic/generated/PluginSecurity.loom</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>