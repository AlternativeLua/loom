## This file contains definitions that should import the runtime library if their types are used.

interface Range {
    minimum: number;
    maximum: number;
    length: number;
    clamp: fn(n: number): number;
}

interface ResultOk<T> {
    ok: true;
    value: T;
}

interface ResultError<Error> {
    ok: false;
    error: Error;
}

type Result<T, Error> = ResultOk<T> | ResultError<Error>;

declare interface ResultStatic {
    ok: fn<T, Error>(value: T): Result<T, Error>;
    err: fn<T, Error>(error: Error): Result<T, Error>;
}

declare let Result: ResultStatic;

## String-valued so the emitted kind is readable in a payload dump, and so the generated
## type alias stays a literal union instead of collapsing to 'number' like a numeric enum.
enum DeserializeErrorKind: string {
    Truncated = "truncated",
    InvalidTag = "invalid_tag",
    InvalidLength = "invalid_length",
    MissingBlob = "missing_blob",
    InvalidBlob = "invalid_blob",
}

## 'buffer' is absent when every field of the type encodes to zero bytes, 'blobs' when the
## value carries none — both are elided rather than sent as an empty buffer or table.
interface Serialized {
    buffer: buffer?;
    blobs: unknown[]?;
}

interface DeserializeError {
    kind: DeserializeErrorKind;
    field: string?;
    offset: number?;
}

## A serializable type's codec as a value, so it can be stored, passed to a generic network
## wrapper, or selected at runtime. Every [serializable] interface emits one.
interface Serializer<T> {
    serialize: fn(value: T): Serialized;
    deserialize: fn(serialized: Serialized): Result<T, DeserializeError>;
}

declare fn serialize_binary<T>(value: T): Serialized;
declare fn deserialize_binary<T>(serialized: Serialized): Result<T, DeserializeError>;
declare fn serializer<T>(): Serializer<T>;

## Picks a codec out of a key-to-type mapping interface using a runtime key. This is the generic
## case serializer::<T>() cannot express, since inside a wrapper's body the type is not known - only
## the key value is. The result stays exactly typed as Serializer<T[K]>, so no cast is needed.
declare fn serializer_of<T, K>(key: K): Serializer<T[K]>;