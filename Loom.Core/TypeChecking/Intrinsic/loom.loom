## Loom standard library

interface Tuple;

interface Record<K, V> {
    [K]: V;
}

interface MutRecord<K, V> {
    mut [K]: V;
}

enum AttributeTargets {
    Function = 1 << 0,
    Interface = 1 << 1,
    Property = 1 << 2,
    Event = 1 << 3,
}

declare fn attribute_usage(targets: AttributeTargets): void;
declare fn luau_name(name: string): void;
declare fn luau_method: void;
declare fn override: void;

declare fn print(..data: unknown[]): void;
declare fn string(value: unknown): string;
declare fn number(value: unknown): number?;

declare fn get_metadata<T>(member_name: string?, attribute: unknown): unknown[]?;
declare fn has_attribute<T>(member_name: string?, attribute: unknown): bool;

[luau_name("typeof")]
declare fn type_of(value: unknown): string;