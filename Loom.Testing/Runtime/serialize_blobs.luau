local part = MakeInstance("Part")
local p = Marker_serialize_binary({ kind = "spawn", target = part })
assert(p.buffer == nil, "zero-width type sends no buffer")
assert(#p.blobs == 1, "one blob")
local r = Marker_deserialize_binary(p)
assert(r.ok and r.value.target == part and r.value.kind == "spawn", "roundtrip")
assert(Marker_deserialize_binary({ blobs = {} }).error.kind == "missing_blob", "missing_blob kind")
local wrong = Marker_deserialize_binary({ blobs = { MakeInstance("Model") } })
assert(not wrong.ok and wrong.error.kind == "invalid_blob", "wrong class reports")
assert(not Marker_deserialize_binary({}).ok, "absent blobs array reports")
