interface IAction<Kind: string> { kind: Kind }

[serializable]
interface LogOutAction: IAction<"LogOut">;

[serializable]
interface ClickAction: IAction<"Click"> {
    x: u8;
}

[serializable]
interface Envelope {
    action: LogOutAction | ClickAction;
    color: "red" | "green" | "blue";
}

fn _trigger_usage(): void {
    let payload = serialize_binary(none as never as Envelope);
    let restored = deserialize_binary::<Envelope>(payload);
}
