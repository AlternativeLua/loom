interface IShape<Kind: string> { kind: Kind }

[serializable]
interface Dot: IShape<"Dot">;

[serializable]
interface Line: IShape<"Line"> {
    label: string;
}

[serializable]
interface Canvas {
    masks: bool[][];
    shapes: (Dot | Line)[];
}

fn _trigger_usage(): void {
    let payload = serialize_binary(none as never as Canvas);
    let restored = deserialize_binary::<Canvas>(payload);
}
