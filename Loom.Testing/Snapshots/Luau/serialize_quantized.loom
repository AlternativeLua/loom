[serializable]
interface Dials {
    [number_range(0, 1), number_step(0.01)]
    opacity: number;
    [number_range(-100, 100), number_step(0.5)]
    offset: number;
    [number_range(0, 100)]
    health: number;
}

fn _trigger_usage(): void {
    let payload = serialize_binary(none as never as Dials);
    let restored = deserialize_binary::<Dials>(payload);
}
