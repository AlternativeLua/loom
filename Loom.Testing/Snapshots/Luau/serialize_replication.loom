## Server-to-client replication for one player, sent every tick.

enum Team { Neutral, Red, Blue }

interface IEvent<Kind: string> { kind: Kind }

[serializable]
interface Damaged: IEvent<"Damaged"> {
    [number_range(0, 1000)]
    amount: number;
    attacker: Player?;
}

[serializable]
interface Respawned: IEvent<"Respawned"> {
    [number_type(NumberType.I16)]
    at: Vector3;
}

[serializable]
interface Loadout {
    primary: u8;
    secondary: u8;
}

[serializable, packed]
interface PlayerSnapshot {
    user_id: u16;
    display_name: string;
    [number_range(0, 100)]
    health: number;
    alive: bool;
    team: Team;
    [number_type(NumberType.I16)]
    velocity: Vector3;
    [cframe_type(CFrameType.Compressed), number_type(NumberType.F32)]
    aim: CFrame;
    loadout: Loadout;
    recent: (Damaged | Respawned)[];
    character: Model?;
}
